# Local development uses SQLite automatically when DATABASE_URL is blank.
# For production, use a managed PostgreSQL URL (e.g. Supabase or Render PostgreSQL).
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
# Change this to a long random secret before deployment. Protects professional endpoints.
ADMIN_API_KEY=change-this-to-a-long-random-secret
# Optional WhatsApp Cloud API integration (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# Optional: set a shared secret for the scheduled reminder endpoint
REMINDER_CRON_SECRET=change-this-too
